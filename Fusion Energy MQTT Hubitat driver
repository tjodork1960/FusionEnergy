metadata {
    definition(name: "Fusion Energy MQTT", namespace: "your_namespace", author: "Tim") {
        capability "Refresh"
        capability "Initialize"
        capability "Voltage Measurement"
        capability "Power Meter"
        capability "Energy Meter"

        attribute "rawData", "string"
        attribute "wattsSummary", "string"  // New attribute for vertical summary
    }

    preferences {
        input("brokerUrl", "text", title: "MQTT Broker URL", 
              description: "Example: tcp://192.168.1.100:1883", 
              defaultValue: "tcp://192.168.1.62:1883")
        input("mqttTopic", "text", title: "MQTT Topic", 
              description: "Topic to subscribe to", 
              defaultValue: "SEMMETER/94A9900AD2F2/HA")
        input("ctLabels", "text", title: "CT Labels JSON", 
              description: 'Example: {"ct1":"Fridge","ct2":"Stove","ct3":"AC"}',
              defaultValue: '{"ct1":"Fridge","ct2":"Stove","ct3":"AC"}')
    }
}

import groovy.json.JsonSlurper

def installed() { initialize() }
def updated() { unsubscribe(); unschedule(); initialize() }

def initialize() {
    log.debug "Initializing MQTT connection to ${brokerUrl} on topic ${mqttTopic}"
    if (!brokerUrl || !mqttTopic) { log.warn "Broker URL or topic not set"; return }
    interfaces.mqtt.connect(brokerUrl, "", "", null)
    interfaces.mqtt.subscribe(mqttTopic)
}

def mqttClientStatus(String status) {
    log.debug "MQTT Status: ${status}"
}

def parse(String message) {
    def msg = interfaces.mqtt.parseMessage(message)
    log.debug "Incoming payload to parse(): ${msg.payload}"

    if (!msg) return

    try {
        def json = new JsonSlurper().parseText(msg.payload)
        if (json?.sense) {
            def totalMain = 0.0
            def totalOthers = 0.0
            def wattsMap = [:]

            json.sense.eachWithIndex { ct, idx ->
                def volts = (ct[0] as BigDecimal) / 10
                def amps  = (ct[1] as BigDecimal) / 100
                def watts = (ct[2] as BigDecimal) / 100000
                def kwh   = (ct[3] as BigDecimal) / 1000

                def labelMap = [
                    0:"Furnace", 1:"Stove", 2:"Main Bath/LR", 3:"AC",
                    4:"Dishwasher", 5:"Den/DR/Sink Lights", 6:"Foyer/Kitchen Lights", 7:"Kitchen Outlets",
                    8:"Master/Blue Beds", 9:"Washer", 10:"RecRm/Low Deck",
                    11:"Microwave", 12:"Family Rm", 13:"Dryer",
                    14:"Fridge/Floor Outlets", 15:"Laundry/Garage", 16:"NA",
                    17:"MainA", 18:"MainB"
                ]
                def name = labelMap[idx] ?: "CT${idx+1}"
                if (name == "NA") return

                sendEvent(name: "${name}_watts", value: watts)
                wattsMap[name] = watts

                if (name == "MainA" || name == "MainB") totalMain += watts
                else totalOthers += watts

                log.debug "Updated ${name}: ${volts}V, ${amps}A, ${watts}W, ${kwh}kWh"
            }

            // Combine MainA + MainB
            def mainTotal = (wattsMap["MainA"] ?: 0) + (wattsMap["MainB"] ?: 0)
            wattsMap.remove("MainA")
            wattsMap.remove("MainB")
            wattsMap["Main"] = mainTotal

            // Calculate Other_watts
            def otherWatts = totalMain - totalOthers
            sendEvent(name: "Other_watts", value: otherWatts)
            wattsMap["Other"] = otherWatts

            // Separate active and inactive
            def active = wattsMap.findAll { it.value > 0 }.sort { -it.value }
            def inactive = wattsMap.findAll { it.value == 0 }.sort { it.key }
            
            
            // Build table-like summary
           def summary = "<b>Watts by Circuit</b><br>"
           (active + inactive).each { entry ->
             summary += "${entry.key}: ${String.format('%.3f', entry.value)}W<br>"
           }
           sendEvent(name: "wattsSummary", value: summary)

        }
    } catch (Exception e) {
        log.error "Parse error: ${e.message}"
    }
}

def mqttMessage(String topic, String message) {
    log.debug "Received MQTT message on topic ${topic}: ${message}"
    sendEvent(name: "rawData", value: message)

    try {
        def labels = [:]
        if (ctLabels) { labels = new JsonSlurper().parseText(ctLabels) }

        def parts = message.split(",")
        int ctIndex = 1

        for (int i = 0; i < parts.size(); i += 4) {
            if ((i + 3) >= parts.size()) break
            def voltage = parts[i].toDouble() / 10
            def current = parts[i + 1].toDouble() / 100
            def power   = parts[i + 2].toDouble() / 100000
            def energy  = parts[i + 3].toDouble() / 1000
            def label   = labels["ct${ctIndex}"] ?: "CT${ctIndex}"

            sendEvent(name: "${label}_voltage", value: voltage, unit: "V")
            sendEvent(name: "${label}_current", value: current, unit: "A")
            sendEvent(name: "${label}_power", value: power, unit: "W")
            sendEvent(name: "${label}_energy", value: energy, unit: "kWh")

            ctIndex++
        }

    } catch (Exception e) {
        log.error "Error parsing MQTT message: ${e}"
    }
}

def refresh() {
    log.debug "Refresh called"
}
