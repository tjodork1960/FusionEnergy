# mqtt_prometheus_bridge.py.example
#
# Copy this to mqtt_prometheus_bridge.py and fill in:
#   1. Your SEM device MAC addresses in ct_mappings (find them by watching
#      MQTT traffic: mosquitto_sub -t "SEMMETER/#" -v). They also appear in
#      the log_senseblock1/2 check in process_queue().
#   2. Your circuit names for each CT channel (1-indexed, 1-19).
#      Use "NA" for unused channels.
#      Pairs ending in -A / -B are automatically merged (e.g. Main-A + Main-B -> Main)
#   3. Your utility's electricity rates (RATE_* below) for the cost metrics.
#
# Optional environment variables (set in docker-compose.yml):
#   ALERT_EMAIL_FROM / ALERT_EMAIL_APP_PASSWORD / ALERT_EMAIL_TO
#       Gmail sender + app password for "SEM meter stopped publishing"
#       alerts. Leave unset to disable email alerts.
#   HEALTHCHECK_PING_URL  - healthchecks.io-style URL pinged every 10 min
#   HUBITAT_POWER_THRESHOLD, HUBITAT_MIN_POWER_DELTA, HUBITAT_MIN_ENERGY_DELTA,
#   HUBITAT_MIN_INTERVAL, HUBITAT_SPIKE_DELTA, BACKUP_HUBITAT
#       How often readings are forwarded to Hubitat (see the comment block
#       further down) - the defaults keep hub load low.
# -------------------------------------------------------------------------
from prometheus_client import start_http_server, Gauge
