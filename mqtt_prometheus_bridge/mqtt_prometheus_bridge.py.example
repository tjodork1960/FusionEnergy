cost_metric = Gauge('ct_cost_dollars', 'Energy cost in dollars', ['ct_name'])

# --- Residential TOU (Time-of-Use) rate schedule ---
# EXAMPLE VALUES - replace with your own utility's $/kWh rates and peak
# windows (and adjust get_rate_per_kwh below if your windows differ).
RATE_OFF_PEAK = 0.08295            # all days/seasons, midnight-8am & 10pm-midnight
RATE_ON_PEAK_SUMMER = 0.20154      # Jun-Sep, 8am-4pm & 8-10pm, every day (weekday and weekend)
RATE_SUPER_PEAK_SUMMER = 0.33885   # Jun-Sep, 4-8pm, weekdays only
RATE_ON_PEAK_NON_SUMMER = 0.16366  # Oct-May, 8am-10pm, every day (no super-peak tier at all)
SUMMER_MONTHS = (6, 7, 8, 9)


def get_rate_per_kwh(dt):
    """$/kWh for the given local datetime, per the TOU schedule above."""
    hour = dt.hour
    if hour < 8 or hour >= 22:
        return RATE_OFF_PEAK
    is_summer = dt.month in SUMMER_MONTHS
    is_weekday = dt.weekday() < 5  # Monday=0 .. Sunday=6
    if is_summer:
        if is_weekday and 16 <= hour < 20:
            return RATE_SUPER_PEAK_SUMMER
        return RATE_ON_PEAK_SUMMER
    return RATE_ON_PEAK_NON_SUMMER

